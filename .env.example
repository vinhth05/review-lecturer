# Local Docker Compose defaults. Replace every secret before any shared or
# internet-accessible deployment; never commit the resulting .env file.
DB_PASSWORD=replace-with-a-strong-sqlserver-password
JWT_SECRET=replace-with-at-least-32-random-bytes
REVIEW_SECRET_KEY=replace-with-a-separate-random-secret
MAIL_USERNAME=
MAIL_PASSWORD=
APP_SEED_ENABLED=false
